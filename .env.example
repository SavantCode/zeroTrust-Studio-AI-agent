# ============================================================================
# 🛡️ ZERO-TRUST AI STUDIO (NEXT.JS) — ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================================
# Copy this file to `.env` or `.env.local` in the project root:
#   cp .env.example .env
#
# SECURITY NOTE:
# `.env`, `.env.local`, and `vertex_credentials.json` are strictly protected by
# Zero-Trust Studio's 5-layer security engine:
#   1. Blocked from AI file reads/snapshots (`isSecretCredentialFile`)
#   2. Blocked from AI file writes/deletes (`safeResolve`)
#   3. Blocked from terminal commands (`riskOf` + stripped from `safeEnv()`)
#   4. Automatically injected into `.gitignore`
#   5. Automatically unstaged before any `git commit` (`unstageProtectedSecrets`)
# ============================================================================

# ----------------------------------------------------------------------------
# 1. GOOGLE CLOUD VERTEX AI — OPTION A: INDIVIDUAL SERVICE ACCOUNT FIELDS
#    (Copy each value directly from your Google Cloud Service Account JSON)
# ----------------------------------------------------------------------------
GOOGLE_TYPE="service_account"
GOOGLE_PROJECT_ID="your-gcp-project-id"
GOOGLE_PRIVATE_KEY_ID="your_private_key_id_here"
# Keep the full PEM key on a single line wrapped in double quotes with \n line breaks:
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_CLIENT_EMAIL="your-service-account@your-gcp-project-id.iam.gserviceaccount.com"
GOOGLE_CLIENT_ID="000000000000000000000"
GOOGLE_AUTH_URI="https://accounts.google.com/o/oauth2/auth"
GOOGLE_TOKEN_URI="https://oauth2.googleapis.com/token"
GOOGLE_AUTH_PROVIDER_X509_CERT_URL="https://www.googleapis.com/oauth2/v1/certs"
GOOGLE_CLIENT_X509_CERT_URL="https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-gcp-project-id.iam.gserviceaccount.com"
GOOGLE_UNIVERSE_DOMAIN="googleapis.com"

# ----------------------------------------------------------------------------
# 2. GOOGLE CLOUD VERTEX AI — OPTION B: SINGLE-LINE JSON OR KEY FILE PATH
#    (Optional alternative to Option A)
# ----------------------------------------------------------------------------
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}'
# GOOGLE_APPLICATION_CREDENTIALS="./vertex_credentials.json"

# ----------------------------------------------------------------------------
# 3. MODEL & VERTEX AI REGION SETTINGS
# ----------------------------------------------------------------------------
GCP_PROJECT="your-gcp-project-id"
GCP_LOCATION="global"
MODEL="gemini-4-argon"

# ----------------------------------------------------------------------------
# 4. STUDIO SERVER & TOKEN / CONTEXT BUDGET SETTINGS (OPTIONAL)
# ----------------------------------------------------------------------------
# Default port for the Studio UI (auto-increments to 3006+ if 3005 is busy)
PORT=3005

# Maximum character budget for total context (snapshot + history) before auto-refresh
CONTEXT_CHAR_BUDGET=800000

# Maximum output tokens per streaming pass (cascades 65536 -> 32768 -> 16384 -> 8192)
MAX_OUTPUT_TOKENS=65536